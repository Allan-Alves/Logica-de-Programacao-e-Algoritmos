Algoritmo "166"
// Data atual: 17/06/2025

// Crie um algoritmo que conte de 10 á 0 utilizando estrutura de repetição
// "Repita" (Do-While).

Var
   // Seção de Declarações das variáveis
   i: Inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   i <- 10
   Repita
      Escreva (i)
      i <- i - 1
   Ate (i < 0)
Fimalgoritmo