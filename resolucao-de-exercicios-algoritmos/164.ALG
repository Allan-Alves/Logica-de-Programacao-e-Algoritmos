Algoritmo "164"
// Data atual: 17/06/2025

// Crie um programa que conte de 1 a 10 utilizando estrutura de repetição
// "Repita" (Do-While).

Var
   // Seção de Declarações das variáveis
   i: Inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   i <- 1
   Repita
      Escreva (i)
      i <- i + 1
   Ate (i > 10)
Fimalgoritmo