Algoritmo "165"
// Data atual: 17/06/2025

// Crie um programa que conte de 0 a 100 (de 10 em 10) utilizando estrutura de
// Repetição "Repita" (Do-While).

Var
   // Seção de Declarações das variáveis
   i: Inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   i <- 0
   Repita
      Escreva (i)
      i <- i + 10
   Ate (i > 100)
Fimalgoritmo